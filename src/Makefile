.PHONY: print
print:
	$(__top_builddir__openBLAHAJ_SOURCES)

.PHONY: install-exec-hook

install-exec-hook:
	setcap cap_net_raw=eip $(DESTDIR)$(bindir)/openBLAHAJ
	ldconfig

