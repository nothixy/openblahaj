	-$(am__rm_f) $(CONFIG_CLEAN_FILES)
	-test . = "$(srcdir)" || $(am__rm_f) $(CONFIG_CLEAN_VPATH_FILES)
	-$(am__rm_f) $(top_builddir)/$(am__dirstamp)
	-$(am__rm_f) application/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) application/$(am__dirstamp)
	-$(am__rm_f) filetypes/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) filetypes/$(am__dirstamp)
	-$(am__rm_f) generic/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) generic/$(am__dirstamp)
	-$(am__rm_f) hooks/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) hooks/$(am__dirstamp)
	-$(am__rm_f) link/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) link/$(am__dirstamp)
